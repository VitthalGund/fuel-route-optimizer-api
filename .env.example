# Django
SECRET_KEY=django-insecure-fuel-route-optimizer-super-secret-key-change-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=fuel_route.settings.development

# Database
# For Supabase PostGIS: postgis://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# For Supabase Postgres: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# For Local SQLite (testing/dev fallback): sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# Redis (cache) - Local or Cloud
REDIS_URL=redis://localhost:6379/0

# OpenRouteService API Key (get free key at https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=

# Vehicle & Corridor configuration
CORRIDOR_MILES=15
TANK_RANGE_MILES=500
VEHICLE_MPG=10
